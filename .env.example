# Names only; never commit values (AGENTS.md §12).
# Set Preview and Production separately in the Vercel project onyou123.
# Those two environments use different Neon branches (docs/setup-and-deployment.md).
# DATABASE_URL is the pooled connection used by the running app.
# DATABASE_URL_UNPOOLED is the direct connection used by prisma migrate deploy.
# SHADOW_DATABASE_URL is only for local prisma migrate dev drift checks.
# TEST_DATABASE_URL is only for local and CI integration tests.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SHADOW_DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET=
# Password reset (#24, docs/agent-memory/auth.md A12, A13). Resend is the only
# email provider. APP_URL is the base for reset links; previews fall back to
# Vercel's VERCEL_URL. Never build links from the request Host header.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_URL=
